{
  "name": "water-companion-coaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "server",
    "web",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @coaster/server && npm run test --workspace @coaster/web",
    "check": "npm run typecheck && npm test",
    "build:web": "npm run build --workspace @coaster/web",
    "dev:client": "npm run tauri --workspace @coaster/client -- dev",
    "build:client": "npm run tauri --workspace @coaster/client -- build --bundles app --ci -- --locked",
    "check:client": "npm run typecheck --workspace @coaster/client && npm run test --workspace @coaster/client",
    "check:client:native": "cargo check --manifest-path client/src-tauri/Cargo.toml --locked",
    "test:client:native": "cargo test --manifest-path client/src-tauri/Cargo.toml --locked --lib",
    "smoke:web": "node --import tsx scripts/smoke-server.mjs",
    "test:firmware": "node scripts/test-firmware.mjs",
    "build:firmware": "node scripts/build-firmware.mjs",
    "admin": "npm run admin --workspace @coaster/server --",
    "provisioning-key": "npm run provisioning-key --workspace @coaster/server --"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
