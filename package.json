{
  "name": "water-companion-coaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @coaster/server",
    "check": "npm run typecheck && npm test",
    "build:web": "npm run build --workspace @coaster/web",
    "test:firmware": "node scripts/test-firmware.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
