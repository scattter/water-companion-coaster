# 生产配置示例：复制为 deploy/.env 后按实际域名修改。
# 这份文件用于 docker compose 的变量替换，不会被打进镜像；
# 容器内部的环境变量由 compose.yaml 逐项列出，避免开发机的 DEVICE_ID/DEVICE_TOKEN 混进生产库。

# 浏览器访问的正式源：必须与 TLS 证书域名一致、不带路径、必须是 https。
APP_ORIGIN=https://coaster.example.com

# 使用 Caddy 叠加文件时必填：只写域名，不带协议。
APP_HOST=coaster.example.com

# 网页容器在宿主机上的监听地址。默认只监听回环，由宿主机上的 Nginx/Caddy 终止 TLS 后转发。
# 没有宿主机反代时，可以改成 0.0.0.0 直接暴露（但设备要求 HTTPS，仍需自备证书）。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

APP_TIMEZONE=Asia/Shanghai

# 0.7.0 自动注册无需签名密钥；仅兼容旧版 BLE v1 时填写以下配置。
# 私钥保存在持久卷，不提交Git，不通过管理网页上传。
# PROVISION_SIGNING_KEY_FILE=/data/provisioning-private.pem
# PROVISION_DEPLOYMENT_ID=工具输出的UUID

# 可信反代网段：后端只采信来自这些地址的 X-Forwarded-For，用于按真实客户端限流。
# 172.16.0.0/12 覆盖 Docker 默认地址池（172.17–172.31）。如果本机 Docker 用了别的网段
# （例如 10.x 或 192.168.x），必须把实际网段加进来，否则所有用户会共用同一个限流计数。
TRUST_PROXY=127.0.0.1,::1,172.16.0.0/12
