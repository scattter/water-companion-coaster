<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:background="@drawable/widget_large_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
        <TextView style="@style/WidgetText" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="饮水陪伴" android:textStyle="bold" android:textSize="14sp" />
        <TextView android:id="@+id/widget_date" style="@style/WidgetCaption" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="饮水小记" android:textSize="10sp" />
        <include layout="@layout/widget_refresh" android:layout_width="36dp" android:layout_height="24dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.1" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" style="@style/WidgetCaption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="2" android:text="今日饮水" android:textSize="12sp" />
            <TextView android:id="@+id/widget_amount" style="@style/WidgetAmount" android:layout_width="match_parent"
                android:layout_height="34dp" android:autoSizeMaxTextSize="32sp" android:gravity="center_vertical" android:text="— ml" />
        </LinearLayout>
        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:src="@drawable/water_cap_drinking" android:scaleType="fitCenter"
            android:contentDescription="喝水的小水豚" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_trend" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_weight="2" android:layout_marginBottom="4dp" android:orientation="vertical">
        <TextView style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="16dp"
            android:text="近 7 天" android:textStyle="bold" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="近七天饮水量" />
            <TextView android:id="@+id/widget_chart_empty" style="@style/WidgetCaption" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:text="同步后显示近七天饮水" />
        </FrameLayout>
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/widget_line" android:importantForAccessibility="no" />
    <TextView style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="18dp"
        android:layout_marginTop="6dp" android:gravity="center_vertical" android:text="最近饮水" android:textStyle="bold" />
    <LinearLayout android:id="@+id/widget_record_first" android:layout_width="match_parent"
        android:layout_height="16dp" android:layout_weight="1" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_time_first" style="@style/WidgetCaption" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/widget_amount_first" style="@style/WidgetText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_record_second" android:layout_width="match_parent"
        android:layout_height="16dp" android:layout_weight="1" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_time_second" style="@style/WidgetCaption" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/widget_amount_second" style="@style/WidgetText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_records_empty" style="@style/WidgetCaption" android:layout_width="match_parent"
        android:layout_height="32dp" android:layout_weight="2" android:gravity="center_vertical" android:text="同步后显示饮水记录" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp"
        android:layout_marginTop="2dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_sync" style="@style/WidgetCaption" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:text="等待同步" android:textSize="10sp" />
        <TextView android:id="@+id/widget_open" style="@style/WidgetText" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:gravity="center" android:paddingStart="8dp"
            android:text="查看记录" android:textColor="@color/widget_accent" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
