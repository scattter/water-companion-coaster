<resources>
    <!-- 小组件色板跟随 Web 默认主题（style.css :root），暗色见 values-night/widget.xml。 -->
    <color name="widget_card">#FFFFFF</color>
    <color name="widget_ink">#23262E</color>
    <color name="widget_muted">#6D7482</color>
    <color name="widget_line">#E3E7EE</color>
    <color name="widget_accent">#3A66D6</color>
    <color name="widget_accent_soft">#E8EEFA</color>
    <color name="widget_bar">#DCE4F8</color>
    <color name="widget_shortcut_bg">#E8EEFA</color>
    <style name="WidgetText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetCaption" parent="WidgetText">
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="WidgetFooter" parent="WidgetCaption">
        <item name="android:textSize">10sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="WidgetAmount" parent="WidgetText">
        <item name="android:textSize">38sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">18sp</item>
        <item name="android:autoSizeMaxTextSize">38sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="WidgetRefresh">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:src">@drawable/widget_refresh</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:contentDescription">刷新饮水数据</item>
    </style>
</resources>
